# Byte-compiled
__pycache__/
*.py[cod]
*.pyd

# Test, coverage and lint caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Environments and builds
.venv/
venv/
env/
build/
dist/
*.egg-info/

# Left behind by installers before 2026-09, which wrote it to prove the
# folder was writable. Neither installer writes it now; it stays ignored so
# an older clone's leftover does not show up as an untracked file.
.writetest

# Screenshots and scratch notes kept beside the repo while working
*.png
*.jpg
*.jpeg

# Cognitive Coder's own working directories, when the tool is run on itself
.cc_journal/
.cc_snapshots/

# Editor and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# The drafted commit message, staged for `git commit -F` — and the used one,
# which push.bat renames after committing so it cannot be committed twice.
.git-commit-message.txt
.git-commit-message.last.txt

# Session state written by MemoryStorage when the engine is run with the repo
# as its project root — codemap SQLite and its journal. Test debris, not
# source, and the default state directory is configurable per host.
.s/
.cc_state/
